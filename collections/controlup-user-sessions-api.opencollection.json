{
  "opencollection": "1.0.0",
  "info": {
    "name": "DaaS IQ User sessions API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "User sessions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Execute an action on a user session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.controlup.com/daas-iq/v1/cloud/user-sessions/:userSessionId/actions",
            "params": [
              {
                "name": "userSessionId",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the user session."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a background job to perform the action (send message, sign out, disconnect). Poll the statusUrl for progress updates."
        }
      ]
    }
  ],
  "bundled": true
}