{
  "opencollection": "1.0.0",
  "info": {
    "name": "VDI & DAAS Support endpoint API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Support endpoint",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Start upload date",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.controlup.com/historical/v1/uploadstartstatus"
          },
          "docs": "Returns date when the first historical data upload was started"
        }
      ]
    }
  ],
  "bundled": true
}