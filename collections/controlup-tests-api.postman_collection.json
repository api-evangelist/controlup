      "item": [
        {
          "id": "4a7ae11a-04e9-4b8f-8d1d-d2e84bd45d5b",
          "name": "List tests",
          "request": {
            "name": "List tests",
            "description": {
              "content": "Returns a list of test, containing the the details and results of each tests. The tests are grouped by their Scouts, with the earliest tests appearing first in each group.\n\nBy default, all tests from all Scouts in the last 24 hours are returned.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "tests"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<dateTime>",
                  "description": "Only return tests initiated after this time."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<dateTime>",
                  "description": "Only return tests initiated before this time. You must specify a `start` time to use this parameter."
                },
                {
                  "disabled": false,
                  "key": "scoutId",
                  "value": "<integer>,<integer>",
                  "description": "Only return tests from the Scouts specified by these Scout IDs."
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Filter the list based on the status of the tests."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "The page of tests returned. Each page contains up to 100 tests. If your request returns more than 100 tests, then the response is paginated."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
