          "name": "Retrieve license usage in time range",
          "request": {
            "name": "Retrieve license usage in time range",
            "description": {
              "content": "Returns license usage data for your organization over a specified time range.\nFor managed organizations, returns usage for that organization.\nFor MSP organizations, returns aggregated usage across all managed organizations.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "organizations",
                ":orgId",
                "license",
                "usage"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "timeFrom",
                  "value": "<ISO String YYYY-MM-DDTHH:mm:ss.sssZ>",
                  "description": "(Required) Start date and time for the usage data range in ISO string format (UTC)."
                },
                {
                  "disabled": false,
                  "key": "timeTo",
                  "value": "<ISO String YYYY-MM-DDTHH:mm:ss.sssZ>",
                  "description": "(Required) End date and time for the usage data range in ISO string format (UTC)."
                },
                {
                  "disabled": false,
                  "key": "childOrgsIds",
                  "value": "<string>",
                  "description": "Array of organization IDs to filter the usage data by."
                },
                {
                  "disabled": false,
                  "key": "childOrgsIds",
                  "value": "<string>",
                  "description": "Array of organization IDs to filter the usage data by."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "orgId",
                  "description": "(Required) ID of your ControlUp organization. You can find your organization ID on the [API Key Management page](how-to-make-api-requests#how-to-find-your-controlup-organization-id) in the DEX platform."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
