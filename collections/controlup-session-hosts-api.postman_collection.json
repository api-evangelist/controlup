          "name": "Get user sessions for a session host",
          "request": {
            "name": "Get user sessions for a session host",
            "description": {
              "content": "Returns the people currently logged in to one session host, scoped to that host alone.\nIn Azure AVD this includes Active, Pending, and Disconnected sessions: any session where the user has not logged off.\nCovers a single host, not the whole pool.",
              "type": "text/plain"
            },
            "url": {
