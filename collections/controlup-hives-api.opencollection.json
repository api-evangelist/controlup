{
  "opencollection": "1.0.0",
  "info": {
    "name": "Synthetic Monitoring Hives API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Hives",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all Custom Hives",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.controlup.com/synthetic-monitoring/v2/hives",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a list of the Custom Hives in your organization."
        },
        {
          "info": {
            "name": "List all Cloud Hives",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.controlup.com/synthetic-monitoring/v2/cloud_hives",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a list of Cloud Hives."
        }
      ]
    }
  ],
  "bundled": true
}