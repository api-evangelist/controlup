        {
          "id": "045138a4-c614-4eb7-8954-7506e7df4034",
          "name": "Create host pool deployment",
          "request": {
            "name": "Create host pool deployment",
            "description": {
              "content": "Starts an asynchronous shell deployment for an Azure Virtual Desktop host pool.\nThe job creates the host pool ARM resource, application group, workspace registration,\nthen imports the created control-plane tree into Foundry.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "cloud",
                "subscriptions",
                ":subscriptionId",
                "host-pool-deployments"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "subscriptionId",
                  "description": "(Required) Foundry cloud subscription identifier."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appGroupType\": \"<string>\",\n  \"hostPoolType\": \"<string>\",\n  \"name\": \"<string>\",\n  \"region\": \"<string>\",\n  \"resourceGroupName\": \"<string>\",\n  \"workspaceResourceId\": \"<string>\",\n  \"appGroupName\": \"<string,null>\",\n  \"loadBalancingAlgorithm\": \"<string>\",\n  \"maxSessionLimit\": \"<integer,null-int32>\",\n  \"assignmentType\": \"<string>\",\n  \"initialHostCount\": 0,\n  \"vmSettings\": {\n    \"availabilityZones\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"deploymentRegion\": \"<string>\",\n    \"deploymentResourceGroupName\": \"<string>\",\n    \"imageSource\": \"<string>\",\n    \"integrityMonitoring\": \"<boolean>\",\n    \"intuneEnrollment\": \"<boolean>\",\n    \"joinType\": \"<string>\",\n    \"localAdminUsername\": \"<string>\",\n    \"networkSecurityGroup\": \"<string>\",\n    \"osDiskSizeBytes\": \"<long>\",\n    \"osDiskStorageAccountType\": \"<string>\",\n    \"primaryVmSize\": \"<string>\",\n    \"publicInboundPorts\": \"<boolean>\",\n    \"secureBoot\": \"<boolean>\",\n    \"securityType\": \"<string>\",\n    \"subnetResourceId\": \"<string>\",\n    \"virtualNetworkResourceId\": \"<string>\",\n    \"vmNamingPrefix\": \"<string>\",\n    \"vTpm\": \"<boolean>\",\n    \"alternativeVmSize\": \"<string,null>\",\n    \"imageResourceId\": \"<string,null>\",\n    \"imageVersionResourceId\": \"<string,null>\",\n    \"existingVmResourceId\": \"<string,null>\",\n    \"adDomain\": \"<string,null>\",\n    \"domainJoinUpn\": \"<string,null>\",\n    \"ouPath\": \"<string,null>\",\n    \"profileStoragePath\": \"<string,null>\",\n    \"tags\": \"<object,null>\",\n    \"localAdminPassword\": \"<string,null>\",\n    \"domainJoinPassword\": \"<string,null>\"\n  },\n  \"tags\": \"<object,null>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
