    {
      "id": "eb6f0641-71ae-4cd2-979a-447bd3ef14d6",
      "name": "Hives",
      "description": {
        "content": "Hives are the locations from which Scouts (tests) are initiated.\n\nCustom Hives allow you to test internal resources from within your network. They must be installed on a computer with access to your network.\n\nCloud hives allow you to test publicly available resources from locations throughout the world. They are hosted and managed by Scoutbees, and require no configuration.\n",
        "type": "text/plain"
      },
