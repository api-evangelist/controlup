{
  "opencollection": "1.0.0",
  "info": {
    "name": "VDI & DAAS Dynamic Query API API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Dynamic Query API",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Transform and Execute SQL Query",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.controlup.com/historical/v1/dynamic-query/execute",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Parse, validate, transform, and execute a SQL query, ensuring the result conforms to the expected structure and can be run safely."
        },
        {
          "info": {
            "name": "Get Database Schema as CSV",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.controlup.com/historical/v1/dynamic-query/schema",
            "params": [
              {
                "name": "tableName",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve the database schema metadata in CSV format for download"
        }
      ]
    }
  ],
  "bundled": true
}