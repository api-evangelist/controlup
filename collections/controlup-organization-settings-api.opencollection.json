{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dex Organization Settings API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Organization Settings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve organization settings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.controlup.com/v1/organizations/:orgId/settings",
            "params": [
              {
                "name": "_format",
                "value": "json",
                "type": "query",
                "description": "The format of returned results."
              },
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "ID of your ControlUp organization. You can find your organization ID on the [API Key Management page](how-to-make-api-requests#how-to-find-your-controlup-organization-id) in the DEX platform."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the current settings for your organization."
        },
        {
          "info": {
            "name": "Update organization settings",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.controlup.com/v1/organizations/:orgId/settings",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "ID of your ControlUp organization. You can find your organization ID on the [API Key Management page](how-to-make-api-requests#how-to-find-your-controlup-organization-id) in the DEX platform."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates your organization settings by setting the value of the parameters passed.\nAny parameters not passed are not changed."
        }
      ]
    }
  ],
  "bundled": true
}